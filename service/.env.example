# Bun loads .env automatically. Every variable is required; there are no defaults in code.
NODE_ENV=development
TASKTOGETHER_LOG_LEVEL=info
TASKTOGETHER_HOST=localhost
PORT=3001
# The one origin the browser app is served from; CORS allows only it.
TASKTOGETHER_CORS_ORIGIN=http://localhost:3000
# Matches compose.yaml; start it with `bun run db:up` from the repo root.
TASKTOGETHER_DATABASE_URL=postgres://tasktogether:tasktogether@localhost:5432/tasktogether
