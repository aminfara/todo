{
  "name": "@tasktogether/root",
  "private": true,
  "type": "module",
  "workspaces": ["app", "service"],
  "engines": { "bun": ">=1.4" },
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "db:up": "(podman machine inspect --format {{.State}} | grep -q running || podman machine start) && podman compose up -d",
    "db:down": "podman compose down"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
